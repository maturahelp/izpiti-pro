# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (public — safe in browser when RLS is configured correctly)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (SECRET — server only, bypasses RLS; used by lib/supabase/admin.ts
# for admin routes and server-side entitlement checks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (SECRET — server only, never expose to client)
STRIPE_SECRET_KEY=sk_test_or_sk_live_xxx
# Stripe webhook signing secret (from the Stripe CLI or Dashboard webhook config)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Generative AI (SECRET — server only; powers the AI помощник chat)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# Base URL used for Stripe redirects
NEXT_PUBLIC_BASE_URL=https://izpiti.pro

# Resend (SECRET — server only)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=MaturaHelp <support@maturahelp.com>
RESEND_REPLY_TO_EMAIL=support@maturahelp.com

# Cron auth for scheduled automation runners
CRON_SECRET=replace-with-long-random-secret
