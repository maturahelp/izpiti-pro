{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "maturahelp.com" }],
      "destination": "https://www.maturahelp.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/email-automations",
      "schedule": "0 7 * * *"
    }
  ]
}
